{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Stores profile information for citizens and protectors",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["citizen", "protector", "admin"] },
        "photoURL": { "type": "string" },
        "gender": { "type": "string" },
        "aadhaarMasked": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "role", "createdAt"]
    },
    "Alert": {
      "title": "SOS Alert",
      "description": "Real-time emergency alerts triggered by citizens",
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "location": { "type": "string" },
        "coords": { "type": "array", "items": { "type": "number" } },
        "timestamp": { "type": "string", "format": "date-time" },
        "severity": { "type": "string" },
        "victimUid": { "type": "string" },
        "victimName": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "resolved"] }
      },
      "required": ["type", "coords", "timestamp", "victimUid", "status"]
    },
    "Evidence": {
      "title": "Evidence Log",
      "description": "Links to recorded audio/video evidence for an alert",
      "type": "object",
      "properties": {
        "alertId": { "type": "string" },
        "type": { "type": "string" },
        "url": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "hash": { "type": "string" }
      },
      "required": ["alertId", "type", "url", "timestamp"]
    },
    "Guardian": {
      "title": "Emergency Guardian",
      "description": "Trusted contacts notified during SOS",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "relation": { "type": "string" },
        "priority": { "type": "string", "enum": ["Primary", "Secondary"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "phone", "createdAt"]
    },
    "HeatmapReport": {
      "title": "Safety Heatmap Report",
      "description": "Community data on area safety",
      "type": "object",
      "properties": {
        "coords": { "type": "array", "items": { "type": "number" } },
        "level": { "type": "integer", "enum": [1, 2, 3, 4, 5], "description": "1: Unsafe, 5: Very Safe" },
        "timestamp": { "type": "string", "format": "date-time" },
        "reporterId": { "type": "string" }
      },
      "required": ["coords", "level", "timestamp"]
    },
    "SafeWalk": {
      "title": "Safe Walk Session",
      "description": "Live monitoring of user movement",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "destination": { "type": "string" },
        "coords": { "type": "array", "items": { "type": "number" } },
        "status": { "type": "string", "enum": ["active", "ended"] },
        "startTime": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "status", "startTime"]
    },
    "Protector": {
      "title": "Live Protector",
      "description": "Real-time location and status of verified protectors",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "pos": { "type": "array", "items": { "type": "number" } },
        "lastUpdate": { "type": "string", "format": "date-time" },
        "isAvailable": { "type": "boolean" }
      },
      "required": ["uid", "name", "pos", "lastUpdate"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "User",
      "description": "User profile documents"
    },
    "/users/{uid}/guardians/{guardianId}": {
      "schema": "Guardian",
      "description": "Emergency contacts for the user"
    },
    "/alerts/{alertId}": {
      "schema": "Alert",
      "description": "Emergency alert documents"
    },
    "/alerts/{alertId}/evidence/{evidenceId}": {
      "schema": "Evidence",
      "description": "Evidence logs for a specific alert"
    },
    "/heatmap/{reportId}": {
      "schema": "HeatmapReport",
      "description": "Crowdsourced safety reports"
    },
    "/safewalks/{walkId}": {
      "schema": "SafeWalk",
      "description": "Active safe walk sessions"
    },
    "/protectors/{uid}": {
      "schema": "Protector",
      "description": "Live protector locations"
    }
  }
}
