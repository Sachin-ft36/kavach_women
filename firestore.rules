rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Auth Helpers
    function isAuthenticated() { return request.auth != null; }
    
    // 🛡️ MASTER ADMIN OVERRIDE: Hardcoded access for singh.sachin16559@gmail.com
    function isAdmin() {
      return isAuthenticated() && (
             request.auth.token.email == 'singh.sachin16559@gmail.com' ||
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isOwner(userId) { 
      return isAuthenticated() && request.auth.uid == userId; 
    }

    function isProtector() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'protector';
    }

    // --- Global Identity Registry (Lockdown Protocol) ---
    match /global_registry/{registryId} {
      allow get: if isAuthenticated();
      allow create: if isAuthenticated();
      allow read, update: if isAuthenticated() && (resource.data.owner == request.auth.uid || isAdmin());
      allow delete: if false;
    }

    // --- Users & Personal Documents ---
    match /users/{userId} {
      allow read: if true; 
      allow write: if isOwner(userId) || isAdmin();
      
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // --- SOS Alerts (Privacy Encrypted) ---
    match /alerts/{alertId} { 
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.victimUid || isAdmin() || isProtector());
      allow create: if isAuthenticated(); 
      allow update: if isAdmin() || isProtector() || request.auth.uid == resource.data.victimUid;
    }

    // --- Zero FIRs (Legal Filing) ---
    match /zero_firs/{firId} {
      allow create: if isAuthenticated(); 
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.victimUid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // 🛡️ Protector Grievances (Incident Reports) 🛡️
    match /protector_grievances/{reportId} {
      allow create: if isAuthenticated(); 
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if false;
    }

    // --- Special Cell Intelligent Reports ---
    match /special_cell_reports/{reportId} {
      allow create: if isAuthenticated(); 
      // 🛡️ SYNC FIX: Allow citizens to read their own reports (UID check)
      allow read, list: if isAuthenticated() && (
        request.auth.uid == resource.data.uid || 
        request.auth.uid == resource.data.realUid || 
        isAdmin()
      );
      allow update: if isAdmin();
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.uid || 
        request.auth.uid == resource.data.realUid || 
        isAdmin()
      ); 
    }

    // --- Protectors Status Hub ---
    match /protectors/{uid} { 
      allow read: if isAuthenticated();
      allow write: if isAdmin(); 
    }

    // --- Master Admin Override (Safety Net) ---
    match /{document=**} { 
      allow read, write: if isAdmin(); 
    }
  }
}
