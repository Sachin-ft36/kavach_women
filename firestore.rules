rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- 🏛️ AUTH & IDENTITY HELPERS (SAFE-GUARDED) ---
    function isAuthenticated() { return request.auth != null; }
    
    function hasRole(role) {
      return isAuthenticated() && request.auth.token != null && request.auth.token.role == role;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
             hasRole('national_commander') ||
             hasRole('admin') ||
             hasRole('super_cell') ||
             request.auth.token.email == 'singh.sachin16559@gmail.com' ||
             request.auth.token.email.lower().matches('.*adminsachin.*') ||
             (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
              (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || 
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_cell' ||
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SuperCell')) ||
             (exists(/databases/$(database)/documents/male_users/$(request.auth.uid)) && 
              get(/databases/$(database)/documents/male_users/$(request.auth.uid)).data.role == 'super_cell') ||
             (exists(/databases/$(database)/documents/women_users/$(request.auth.uid)) && 
              get(/databases/$(database)/documents/women_users/$(request.auth.uid)).data.role == 'super_cell')
      );
    }

    function isOwner(userId) { 
      return isAuthenticated() && request.auth.uid == userId; 
    }

    function isProtector() {
      return isAuthenticated() && (
             hasRole('protector') ||
             (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'protector') ||
             (exists(/databases/$(database)/documents/male_users/$(request.auth.uid)) && get(/databases/$(database)/documents/male_users/$(request.auth.uid)).data.role == 'protector') ||
             (exists(/databases/$(database)/documents/women_users/$(request.auth.uid)) && get(/databases/$(database)/documents/women_users/$(request.auth.uid)).data.role == 'protector')
      );
    }

    // --- 📡 SECTOR: SYSTEMATIC MIRRORING ---
    
    // 1. MASTER LEDGER (CITIZENS & PROTECTORS)
    match /users/{userId} {
      allow list: if isAuthenticated();
      allow read: if isAuthenticated() && (
        isOwner(userId) || 
        isAdmin() || 
        isProtector() ||
        (resource != null && 'role' in resource.data && resource.data.role == 'protector')
      ); 
      allow update: if isAdmin() || (
        isOwner(userId) && 
        // 🛡️ SECURITY SHIELD: Prevents users from self-verifying or escalating their role to admin/super_cell
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isVerified']) || request.resource.data.isVerified == false) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified']) || request.resource.data.verified == false) &&
        (!('role' in request.resource.data) || !(request.resource.data.role in ['admin', 'super_cell', 'SuperCell']))
      ) || (
        isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['xp', 'livesSaved', 'successfulRescues', 'abortedAssists', 'missionHistory', 'stats', 'rating', 'ratingCount'])
      );
      allow create: if isAdmin() || (
        isOwner(userId) &&
        (!('isVerified' in request.resource.data) || request.resource.data.isVerified == false) &&
        (!('role' in request.resource.data) || !(request.resource.data.role in ['admin', 'super_cell', 'SuperCell']))
      );
      allow delete: if isAdmin();
      
      // 🛡️ FORENSIC EVIDENCE VAULT (WORM: Write Once, Read Many)
      match /evidence/{evidenceId} {
        allow read, create: if isOwner(userId) || isAdmin();
        allow update, delete: if isAdmin(); // Only Admin can purge for legal cleanup
      }
      
      match /{allSubcollections=**} { allow read, write: if isOwner(userId) || isAdmin(); }
    }

    // 2. MALE SECTOR
    match /male_users/{userId} {
      allow read: if isAuthenticated(); 
      allow write: if isOwner(userId) || isAdmin();
      match /{allSubcollections=**} { allow read, write: if isOwner(userId) || isAdmin(); }
    }

    // 3. WOMEN SECTOR
    match /women_users/{userId} {
      allow read: if isAuthenticated(); 
      allow write: if isOwner(userId) || isAdmin();
      match /safety_data/{docId} { allow read, write: if isOwner(userId) || isAdmin(); }
      match /protector_data/{docId} { allow read, write: if isOwner(userId) || isAdmin(); }
      match /{allSubcollections=**} { allow read, write: if isOwner(userId) || isAdmin(); }
    }

    // 🚗 4. NATIONAL TRANSIT REGISTRY (SAFE RIDE)
    match /journeys/{userId} {
      allow read: if isAuthenticated(); // Allow reading for call signaling
      allow write: if isOwner(userId) || isAdmin() || isProtector();
    }

    // --- 📖 SECTOR: SAFETY TIPS & FIELD REPORTS ---
    match /safety_tips/{tipId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    match /protector_guides/{guideId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /protector_reports/{reportId} {
      allow create: if isAuthenticated(); 
      allow read: if isAuthenticated() && (isAdmin() || (resource != null && 'uid' in resource.data && request.auth.uid == resource.data.uid));
      allow update: if isAdmin();
      allow delete: if false;
    }

    // --- 🚨 SOS ALERTS & JUSTICE ---
    match /alerts/{alertId} { 
      allow read: if isAuthenticated(); 
      allow create: if isAuthenticated(); 
      allow update: if isAuthenticated(); 
      allow delete: if isAdmin();
      
      match /evidence/{evidenceId} {
        allow read, create: if isAuthenticated();
        allow update, delete: if isAdmin();
      }
    }

    match /firs/{firId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /zero_firs/{firId} {
      allow create: if isAuthenticated(); 
      allow read: if isAuthenticated() && (isAdmin() || (resource != null && 'victimUid' in resource.data && request.auth.uid == resource.data.victimUid));
      allow update, delete: if isAdmin();
    }

    // --- 📡 COMMAND HUB CHATS & REGISTRY ---
    match /commandhub_chats/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
      match /messages/{messageId} { allow read, write: if isOwner(userId) || isAdmin(); }
    }

    match /global_registry/{registryId} {
      allow read: if isAuthenticated() && (isAdmin() || (resource != null && 'owner' in resource.data && resource.data.owner == request.auth.uid));
      allow write: if isAuthenticated() && (isAdmin() || (resource == null || (resource != null && 'owner' in resource.data && resource.data.owner == request.auth.uid)));
    }

    // --- LEGACY REPORTS & STATUS ---
    match /protector_grievances/{reportId} {
      allow create, read: if isAuthenticated(); 
      allow update: if isAdmin();
    }

    match /special_cell_reports/{reportId} {
      allow create, read: if isAuthenticated() || isAdmin(); 
      allow update: if isAdmin();
    }

    match /protectors/{uid} { 
      allow read: if isAuthenticated();
      allow write: if isAdmin(); 
    }

    // --- ⚖️ NATIONAL ADJUDICATION REGISTRY (APPEALS) ---
    match /appeals/{appealId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && (isAdmin() || (resource != null && 'userId' in resource.data && request.auth.uid == resource.data.userId));
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- 🚨 PHASE 20: IMMUTABLE AUDIT LEDGER (FORENSIC VAULT) ---
    match /incident_audit_ledger/{docId} {
      allow read: if isAuthenticated() && (isAdmin() || hasRole('super_cell') || hasRole('national_commander'));
      allow create: if isAuthenticated();
      // 🔒 FORENSIC LOCK: No edits or deletes allowed by ANYONE, even admins.
      allow update, delete: if false;
    }

    // --- 🚨 FINAL SAFETY NET ---
    match /{document=**} { 
      allow read, write: if isAdmin(); 
    }
  }
}
